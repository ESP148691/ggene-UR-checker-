{
  "name": "ggene-ur-checker",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "exclude": ["worker.js", "wrangler.jsonc", "migrations/*"]
  },
  // ㉖ 定時分析：毎日UTC 19:00（JST 4:00）にworker.jsのscheduled()を実行
  "triggers": {
    "crons": ["0 19 * * *"]
  },
  // ㉖ 運営者（report.html・/api/admin/*を使えるログインユーザー名）。カンマ区切りで複数可
  "vars": {
    "ADMIN_USERNAMES": "ESP"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ggene-ur-checker-db",
      "database_id": "cedb4e09-5ae8-45e4-82f3-cf35d3da7388"
    }
  ]
}
